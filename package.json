{
  "name": "evidara",
  "version": "1.0.0",
  "description": "Research with the evidence in view. Discover papers, compare studies, and create traceable research briefs.",
  "main": "public/index.html",
  "type": "module",
  "scripts": {
    "repo:init": "node scripts/init-local.js",
    "log:decision": "node scripts/log-decision.js",
    "dev": "netlify dev",
    "build": "node scripts/build-assets.js",
    "lint": "eslint netlify/functions/**/*.ts",
    "lint:fix": "eslint netlify/functions/**/*.ts --fix",
    "format": "prettier --write \"netlify/functions/**/*.ts\"",
    "format:check": "prettier --check \"netlify/functions/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "validate": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "sync-wiki": "node scripts/sync-wiki.js",
    "predev": "npm run build",
    "prepreview": "npm run build",
    "preview": "vite public --host 127.0.0.1 --port 4173 --strictPort",
    "test:ui": "node scripts/verify-ui.mjs",
    "lint:ui": "eslint --no-ignore -c .eslintrc.ui.json public/app.js public/js/export.js scripts/build-assets.js scripts/verify-ui.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@google/genai": "^2.21.0",
    "@netlify/functions": "^2.6.0",
    "@phosphor-icons/web": "^2.1.2",
    "@upstash/redis": "^1.38.4",
    "@upstash/vector": "^1.2.3",
    "dotenv": "^16.4.5",
    "pdf-parse": "^1.1.1",
    "vis-network": "^10.1.2"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "jsdom": "^24.0.0",
    "netlify-cli": "^27.4.3",
    "playwright": "^1.63.0",
    "prettier": "^3.2.0",
    "typescript": "^5.4.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
