# Evidara — Environment Variables
# Copy this file to .env and fill in your values.

# Required: Your Google Gemini API key
GEMINI_API_KEY=your_gemini_api_key_here

# Legacy setting: currently NOT enforced; see docs/security/SECURITY-FINDINGS.md
WORKSPACE_PASSCODE=your_passcode_here

# Optional: Upstash Redis (Session Persistence & Distributed Cache)
# Free serverless Redis: https://upstash.com
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here

# Optional: Upstash Vector DB (Reasoning Chains & Long-Term Embeddings)
# Free serverless Vector: https://upstash.com
UPSTASH_VECTOR_REST_URL=https://your-upstash-vector-url.upstash.io
UPSTASH_VECTOR_REST_TOKEN=your_upstash_vector_rest_token_here
